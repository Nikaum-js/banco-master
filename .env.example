# Supabase (spec 037 — fundação multiplayer). Copie para `.env` e preencha.
# A publishable/anon key é PÚBLICA por design (vai no bundle do frontend, protegida por RLS).
# NUNCA use a `service_role`/`sb_secret_*` aqui.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Monitoramento de exceção (spec 044, D-040). OPCIONAL: sem DSN, nenhum código de
# monitoramento roda. Só o identificador de ocorrência, mensagem e pilha viajam —
# nunca nome, mão de cartas, token de sessão ou código de reentrada.
VITE_SENTRY_DSN=

# Telemetria de produto (spec 044, D-040). Sem `1`, nada é enviado — e em
# desenvolvimento nunca é, independente deste valor.
VITE_TELEMETRY=
