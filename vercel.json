{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": null,
  "git": {
    "deploymentEnabled": { "main": false }
  },
  "redirects": [
    { "source": "/", "has": [{ "type": "query", "key": "room" }], "destination": "/jogar", "permanent": false },
    { "source": "/", "has": [{ "type": "query", "key": "host" }], "destination": "/jogar", "permanent": false },
    { "source": "/", "has": [{ "type": "query", "key": "local" }], "destination": "/jogar", "permanent": false },
    { "source": "/", "has": [{ "type": "query", "key": "players" }], "destination": "/jogar", "permanent": false }
  ],
  "rewrites": [
    { "source": "/jogar", "destination": "/jogar.html" },
    { "source": "/como-jogar", "destination": "/como-jogar.html" },
    { "source": "/faq", "destination": "/faq.html" }
  ],
  "headers": [
    {
      "source": "/(index|jogar|como-jogar|faq|404)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(jogar|como-jogar|faq)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
